rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read untuk portfolio display, admin can write
    match /about/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /interests/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /skills/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /projects/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /certificates/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /contact/{docId} { allow read: if true; allow write: if request.auth != null; }
    
    // Messages: only via server API with secret
    match /messages/{msgId} {
      allow create: if request.resource.data._secret == "boatmie_contact_secret_2026"
                    && request.resource.data.keys().hasAll(['name','email','category','message', '_secret'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.message is string
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if request.auth != null;
    }
    
    // Default deny
    match /{document=**} { allow read, write: if false; }
  }
}
